{
  "name": "senior-developer-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A public personal archive, blog, portfolio and AI learning platform.",
  "scripts": {
    "assemble": "node scripts/assemble-sources.mjs",
    "build": "node scripts/build.mjs",
    "check:security": "python3 scripts/safe_source_export.py --check-only && python3 ops/deploy/preflight.py .env.production.example --allow-placeholders",
    "check:frontend": "npm run build",
    "check:backend": "node scripts/run-backend-tests.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "release:setup": "bash scripts/configure-github-release.sh",
    "check:deploy": "npm run check:workflows && bash ops/deploy/release.sh --plan ops/deploy/release-2026.07.31.env && bash ops/deploy/rollback.sh --plan ops/deploy/release-2026.07.31.env",
    "check": "npm run check:security && npm run check:frontend && npm run check:backend && npm run check:deploy",
    "export:source": "python3 scripts/safe_source_export.py",
    "publish:oss": "npm run build && backend/.venv/bin/python backend/scripts/publish_static.py",
    "publish:oss:dry-run": "npm run build && backend/.venv/bin/python backend/scripts/publish_static.py --dry-run",
    "deploy:check": "python3 ops/deploy/preflight.py && docker compose -f docker-compose.prod.yml --env-file .env.production config --quiet",
    "deploy:release": "bash ops/deploy/release.sh",
    "deploy:rollback": "bash ops/deploy/rollback.sh",
    "deploy:verify": "./ops/deploy/acceptance.sh",
    "backup:verify": "python3 ops/backup/verify_backup.py",
    "backup:drill": "python3 ops/backup/restore_drill.py",
    "maintenance:once": "cd backend && .venv/bin/python -m scripts.maintenance_loop --once",
    "dev": "python3 -m http.server 4173",
    "edit": "npm run assemble && node scripts/edit-server.mjs",
    "start": "python3 -m http.server 4173"
  },
  "keywords": [
    "portfolio",
    "personal-website",
    "software-engineer"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "cytoscape": "^3.33.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.6"
  }
}
